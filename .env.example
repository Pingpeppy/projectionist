# Copy to .env (or export these variables) and fill in your values.

# --- SSH connection to the media server (required) ---
# Tailscale tailnet IP or MagicDNS name recommended.
PLEX_SSH_HOST=
# SSH user on the media server (defaults to your local username).
PLEX_SSH_USER=
# SSH port (defaults to 22).
PLEX_SSH_PORT=22
# Dedicated private key for this connection (recommended).
PLEX_SSH_KEY=~/.ssh/plex_manage

# --- Config file locations ON THE MEDIA SERVER (required for arrctl.py / tautulli.sh) ---
# API keys are read from these files at call time; nothing is stored locally.
PLEX_SONARR_CONFIG=/path/to/sonarr/config.xml
PLEX_RADARR_CONFIG=/path/to/radarr/config.xml
PLEX_TAUTULLI_CONFIG=/path/to/tautulli/config.ini

# --- Plex MCP server (optional; defaults shown) ---
PLEX_MCP_CONTAINER=plex-mcp
PLEX_MCP_BINARY=plex-mcp-server
